# Copy this file to .env and fill in only the connectors you want.

# App defaults
TIMEZONE=America/Phoenix

# Canvas
# Example: https://your-school.instructure.com
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=

# Google Calendar
# Start with read/free-busy access. Event creation can be enabled later.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

