# Copy this file to .env and fill in only the connectors you want.

# App defaults
TIMEZONE=America/Phoenix
APP_URL=http://127.0.0.1:8765
# Local preview only. Hosted reverse-proxy deployments must set this to 1.
BETWEEN_BEHIND_PROXY=0

# Gemini (optional; leave the key blank for local rule fallbacks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Canvas assignments through a subscribed Google calendar
CANVAS_CALENDAR_NAME=canvas

# Legacy direct Canvas API (optional)
# Example: https://your-school.instructure.com
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=

# Google Calendar and Tasks (use an independent development account)
# OAuth requests calendar.readonly, calendar.events, and tasks scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

